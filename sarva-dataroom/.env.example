# Generate long random values. Never commit real values.
DATA_ROOM_ACCESS_CODE=replace-with-private-access-code
DATA_ROOM_SESSION_TOKEN=replace-with-at-least-32-random-characters

# Comma-separated. Add Dipseka and approved advisors only.
DATA_ROOM_ALLOWED_EMAILS=dipseka@example.com,advisor@example.com

# Read-only Google Drive service account credentials.
# Share only the dedicated Sarva Data Room Drive folder with this service account.
GOOGLE_DRIVE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-drive-folder-id
