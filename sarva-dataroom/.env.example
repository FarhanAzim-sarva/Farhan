# Generate long random values. Never commit real values.
DATA_ROOM_ACCESS_CODE=replace-with-private-access-code
DATA_ROOM_SESSION_TOKEN=replace-with-at-least-32-random-characters

# Comma-separated. Add Dipseka and approved advisors only.
DATA_ROOM_ALLOWED_EMAILS=dipseka@example.com,advisor@example.com

# Google Drive service account credentials.
# Share ONLY the dedicated Sarva folders with this service account.
GOOGLE_DRIVE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Investor diligence files / PDFs / decks / financial models.
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-data-room-folder-id

# Separate private internal folder used for shared KPI, task, contact,
# blocker, investor and opportunity records.
GOOGLE_DRIVE_OPERATIONS_FOLDER_ID=replace-with-private-operations-folder-id

# Optional email campaign connector. Keep the API key only in deployment secrets.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="Sarva <updates@sarvabazaar.com>"
